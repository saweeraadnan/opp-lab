#include <iostream>
using namespace std;

class Complex
{
private:
    float real, imag;

public:
    Complex(float r = 0, float i = 0)
    {
        real = r;
        imag = i;
    }

    // Addition Operator
    Complex operator+(Complex c)
    {
        return Complex(real + c.real, imag + c.imag);
    }

    // Subtraction Operator
    Complex operator-(Complex c)
    {
        return Complex(real - c.real, imag - c.imag);
    }

    // Multiplication Operator
    Complex operator*(Complex c)
    {
        return Complex(real * c.real - imag * c.imag,
                       real * c.imag + imag * c.real);
    }

    // Assignment Operator
    void operator=(Complex c)
    {
        real = c.real;
        imag = c.imag;
    }

    void display()
    {
        cout << real << " + " << imag << "i" << endl;
    }
};

int main()
{
    Complex c1(3, 4), c2(2, 5);

    Complex sum = c1 + c2;
    Complex diff = c1 - c2;
    Complex mul = c1 * c2;

    cout << "Addition: ";
    sum.display();

    cout << "Subtraction: ";
    diff.display();

    cout << "Multiplication: ";
    mul.display();

    Complex c3;
    c3 = c1;

    cout << "Assignment: ";
    c3.display();

    return 0;
}
