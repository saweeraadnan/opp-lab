#include <iostream>
using namespace std;

class Payroll
{
private:
    double hourlyRate;
    double hoursWorked;
    double totalPay;

public:
    void setData(double rate, double hours)
    {
        hourlyRate = rate;
        hoursWorked = hours;
        totalPay = hourlyRate * hoursWorked;
    }

    double getPay()
    {
        return totalPay;
    }
};

int main()
{
    Payroll employees[7];
    double rate, hours;

    for (int i = 0; i < 7; i++)
    {
        cout << "Employee " << i + 1 << endl;

        cout << "Enter hourly pay rate: ";
        cin >> rate;

        do
        {
            cout << "Enter hours worked (max 60): ";
            cin >> hours;

            if (hours > 60)
                cout << "Invalid input! Hours cannot exceed 60.\n";

        } while (hours > 60);

        employees[i].setData(rate, hours);
    }

    cout << "\nGross Pay of Employees\n";

    for (int i = 0; i < 7; i++)
    {
        cout << "Employee " << i + 1
             << " Pay = " << employees[i].getPay() << endl;
    }

    return 0;
}
