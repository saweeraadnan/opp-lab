#include <iostream>
using namespace std;

class PersonData
{
private:
    string lastName, firstName, address, city, state, zip, phone;

public:
    void setData()
    {
        cout << "Enter First Name: ";
        cin >> firstName;

        cout << "Enter Last Name: ";
        cin >> lastName;

        cin.ignore();

        cout << "Enter Address: ";
        getline(cin, address);

        cout << "Enter City: ";
        getline(cin, city);

        cout << "Enter State: ";
        getline(cin, state);

        cout << "Enter Zip Code: ";
        getline(cin, zip);

        cout << "Enter Phone Number: ";
        getline(cin, phone);
    }

    void displayData()
    {
        cout << "\nFirst Name: " << firstName;
        cout << "\nLast Name: " << lastName;
        cout << "\nAddress: " << address;
        cout << "\nCity: " << city;
        cout << "\nState: " << state;
        cout << "\nZip: " << zip;
        cout << "\nPhone: " << phone;
    }
};

class CustomerData : public PersonData
{
protected:
    int customerNumber;
    bool mailingList;

public:
    void setCustomer()
    {
        cout << "Enter Customer Number: ";
        cin >> customerNumber;

        cout << "Join Mailing List? (1=Yes, 0=No): ";
        cin >> mailingList;
    }

    void displayCustomer()
    {
        cout << "\nCustomer Number: " << customerNumber;
        cout << "\nMailing List: ";
        if (mailingList)
            cout << "Yes";
        else
            cout << "No";
    }
};

class PreferredCustomer : public CustomerData
{
private:
    double purchasesAmount;
    double discountLevel;

public:
    void setPreferredCustomer()
    {
        cout << "Enter Total Purchases Amount: ";
        cin >> purchasesAmount;

        if (purchasesAmount >= 2000)
            discountLevel = 10;
        else if (purchasesAmount >= 1500)
            discountLevel = 7;
        else if (purchasesAmount >= 1000)
            discountLevel = 6;
        else if (purchasesAmount >= 500)
            discountLevel = 5;
        else
            discountLevel = 0;
    }

    void displayPreferredCustomer()
    {
        cout << "\nTotal Purchases: $" << purchasesAmount;
        cout << "\nDiscount Level: " << discountLevel << "%";
    }
};

int main()
{
    PreferredCustomer pc;

    pc.setData();
    pc.setCustomer();
    pc.setPreferredCustomer();

    cout << "\n\n===== Customer Information =====";
    pc.displayData();
    pc.displayCustomer();
    pc.displayPreferredCustomer();

    return 0;
}
